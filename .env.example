# Copy this file to .env.local and fill in values.
# Never commit .env.local or real keys.

# --- required for later agent stages (Phase 2+) ---
OPENROUTER_API_KEY=

# --- required for paid media stages (Phase 5–7; do not use until Phase 12) ---
FAL_API_KEY=
SHOTSTACK_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# --- storage / jobs ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Optional in Phase 1; needed later for storage uploads and bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" only when you intentionally want /api/smoke to ping live APIs.
# Default is false so empty keys and local tests never spend money.
YURYVOX_SMOKE_LIVE=false
